// ─────────────────────────────────────────────────────────────────────
// THE WEAVE · רשת האימות לסוכני AI — Prisma Schema
// עיקרון: "שום טענה בלי מדידה" — כל טענה נחתמת, נמדדת ונקשרת בשרשרת hash.
// ─────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// סוכן עם זהות EVM אמיתית (secp256k1 → כתובת Ethereum)
model Agent {
  id           String        @id @default(cuid())
  name         String        @unique
  role         String // AUDITOR | SCOUT | BUILDER | DAEMON | RELAYER
  ethAddress   String        @unique // זהות EVM — נגזרת ממפתח ציבורי, לא סודית
  pubKeyHex    String // מפתח ציבורי uncompressed — לאימות עצמאי אופליין
  devKeyHex    String? // ⚠ DEVNET בלבד. בייצור המפתח הפרטי אצל הסוכן, לעולם לא ב-DB
  status       String        @default("ACTIVE") // ACTIVE | SUSPENDED | SLASHED
  nonce        Int           @default(0) // EVM-3: מונה monotonic — replay protection לפעולות זהות
  rotatedAt    DateTime? // מתי סובב המפתח האחרון (אם בכלל)
  createdAt    DateTime      @default(now())
  attestations Attestation[]
  keyOps       KeyOp[]
  builderToken BuilderToken?  @relation("BuilderToken")
  charterBuilds CharterProject[] @relation("CharterBuilds")

  @@index([status])
}

// רשומת אימות בספר — hash-chained, חתומה EIP-191
model Attestation {
  id           String    @id @default(cuid())
  seq          Int       @unique
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  claim        String // הטענה עצמה
  claimType    String // MEASUREMENT | BUILD | AUDIT | ROTATION | ANCHOR | SELFTEST
  evidence     String // המדידה / הראיה (טקסט קנוני)
  evidenceHash String // keccak256(evidence)
  status       String // VERIFIED | REFUTED | UNMEASURED | CONTESTED
  prevHash     String // entryHash של הרשומה הקודמת; GENESIS לראשונה
  entryHash    String // keccak256(רשומה קנונית) — הקישור בשרשרת
  sig          String? // חתימת EIP-191 של מפתח הסוכן על entryHash
  signerAddr   String? // כתובת ששוחזרה ב-ecrecover — חייבת להתאים ל-agent.ethAddress
  createdAt    DateTime // נקבע בקוד (לא default) — כדי שה-hash יהיה דטרמיניסטי

  @@index([seq])
  @@index([agentId])
}

// נקודת עוגן: Merkle root חתום EIP-712, מועמד להטבעה בשרשרת EVM
model Checkpoint {
  id           String   @id @default(cuid())
  index        Int      @unique
  attFrom      Int // seq ראשון בטווח
  attTo        Int // seq אחרון בטווח
  leafCount    Int      @default(0)
  root         String // Merkle root של entryHash-ים בטווח
  prevRoot     String // root של ה-checkpoint הקודם — שרשרת בתוך שרשרת
  entryHash    String // EIP-712 digest של רשומת ה-checkpoint
  sig          String? // חתימת EIP-712 של מפתח הרשת
  signerAddr   String? // כתובת הרשת ששוחזרה
  anchorStatus String   @default("LOCAL") // LOCAL | PENDING | ANCHORED
  anchorNet    String? // למשל "sepolia" — רק כשיעוגן בפועל
  anchorTx     String? // tx hash — רק כשיעוגן בפועל
  calldata     String? // ה-calldata המדויק שיישלח ל-AnchorRegistry
  createdAt    DateTime @default(now())
}

// מפתח הרשת — חותם checkpoints. ⚠ DEVNET: מאוחסן ב-DB לצורך הדגמה בלבד
model NetworkKey {
  id        String   @id @default("weave-network")
  address   String   @unique
  devKeyHex String
  createdAt DateTime @default(now())
}

// פעולת מפתח — רוטציית זהות חתומה EIP-712 עם nonce (שער EVM-3)
// המפתח הישן חותם על ההעברה לכתובת החדשה; ה-nonce מונע replay של הפעולה
model KeyOp {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  kind        String // ROTATION
  nonce       Int // ה-nonce שנצרך — חד-פעמי לכל סוכן
  oldAddress  String
  newAddress  String
  digest      String // EIP-712 digest של פעולת ההעברה
  sig         String // חתימת המפתח הישן — ההרשאה להעברה
  recovered   String // כתובת ששוחזרה ב-ecrecover — חייבת להתאים לישנה
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([agentId])
}

// רישום עוגן מקומי — מראה מדויקת של mapping ה-roots שב-Solidity (EVM-2 במצב LOCAL).
// ⚠ זו סימולציית חוזה בצד השרת — לא שרשרת אמיתית. תווית האמת: LOCAL.
model LocalAnchor {
  id              String   @id @default(cuid())
  registryIndex   Int      @unique // latestIndex — מנוהל בדיוק כמו בחוזה (+=1)
  root            String   @unique // roots[registryIndex]
  checkpointIndex Int      @unique // קישור החוצה: איזה checkpoint עוגן (פעם אחת)
  attFrom         Int
  attTo           Int
  calldata        String // ה-calldata שבוצע — בדיוק כמו tx לחוזה
  anchoredBy      String // msg.sender מדומה — כתובת מפתח הרשת
  anchoredAt      DateTime @default(now())
}

// מלאי הריפוים — ממצאי הביקורת (seed מבוסס ביקורת 2026-09)
model RepoInventory {
  id          String @id @default(cuid())
  name        String @unique
  sizeMb      Float  @default(0)
  currentRole String
  targetRole  String
  findings    String
  dupScore    Float  @default(0) // 0..1 — מידת שכפול מדודה
  status      String @default("AUDITED") // AUDITED | CONSOLIDATED | ARCHIVED | DELETED
}

// לוח התוכנית — שלב נסגר רק ע"י אימות VERIFIED (השער המובנה)
model PlanStage {
  id       String @id @default(cuid())
  code     String @unique // L0..L4 | R1..R3 | EVM-1..EVM-3
  title    String
  detail   String
  gate     String // תנאי סגירה — מדידה נדרשת, בלי מילים
  gateType String // claimType שחייב להופיע באימות הסוגר
  state    String @default("PLANNED") // PLANNED | IN_PROGRESS | GATED | DONE
  attSeq   Int? // seq של האימות שסגר את השער
  sortOrder Int  @default(0)
}

// שוק האמת — ספר אירועים hash-chained. הסחורה: הכרעה עתידית של טענות
// מדידות; השופט: המדידה של הרשת עצמה (PlanStage/Checkpoint/Attestation)
// — לא הצבעה ולא כסף. ההון: "נקודות אמת" (מוניטין מוצהר, אפס כסף אמיתי —
// דוקטרינת האפס נשמרת). כל אירוע חתום EIP-191: STAKE בחתימת הסוכן
// שמהמר; OPEN/SETTLE/REFUND בחתימת מפתח הרשת (אותו מפתח של checkpoints).
// הסליקה נכתבת כאימות MARKET בספר הראשי ⇒ checkpoint ⇒ עיגון ב-$0.
model MarketEvent {
  id          String   @id @default(cuid())
  seq         Int      @unique
  kind        String   // OPEN | STAKE | SETTLE | REFUND
  payload     String   // JSON קנוני (סדר-שדות קבוע) — תוכן האירוע
  payloadHash String   // keccak256(payload)
  prevHash    String   // entryHash של האירוע הקודם; GENESIS לראשון
  entryHash   String   // keccak256(רשומה קנונית) — הקישור בשרשרת
  sig         String?  // EIP-191 של digest ה-payload — חתימת הפועל
  signerAddr  String?  // כתובת ששוחזרה ב-ecrecover — חייבת להתאים לצפוי
  createdAt   DateTime // נקבע בקוד (לא default) — דטרמיניסטי ל-hash

  @@index([kind])
}

// המוח הריבוני — מאגר מפתחות NVIDIA NIM אטומים (AES-256-GCM תחת
// גזירת מפתח-הרשת, אותה נוסחה של ה-DAEMONs). רוטציה אוטומטית:
// 429→קירור 90ש' למפתח-בודד; 401/403→30 דק'; הבא משרת מיד. הסוד
// עצמו לעולם לא עוזב את ה-DB המקומי (gitignored) — ב-API רק
// טביעת-אצבע בלתי-הפיכה וסטטוס. תווית אמת: המודל נקרא חי מ-NVIDIA.
model BrainKey {
  id            String   @id // brain-<fingerprint>
  fingerprint   String   @unique // nv-fp:sha256[0:16] — בלתי-הפיך
  encKey        String // AES-256-GCM ciphertext (hex)
  keyIv         String // 12B IV (hex)
  keyTag        String // 16B GCM tag (hex)
  status        String   @default("unverified") // verified | unverified
  lastCode      String? // קוד HTTP אחרון מ-NVIDIA
  cooldownUntil DateTime? // עד מתי המפתח בקירור (429/401/403)
  verifiedAt    DateTime? // מתי אומת חי לאחרונה (1-token chat)
  createdAt     DateTime @default(now())
}

// ── דפדפן הסוכנים ─────────────────────────────────────────────────────
// סשן גלישה שמור שניתן לשיתוף כ"קישורית חכמה": ‎/#/browser?s=<slug>‎.
// המצב עצמו JSON (כרטיסיות + הקשר פעיל) — שחזור מלא בכל דומיין שהאתר
// ייפרס עליו (השעת הסנדבוקס או שרת ריבוני עתידי).
model BrowserSession {
  id        String         @id @default(cuid())
  slug      String         @unique // 8 תווי base62 — קצר וניתן לשיתוף
  title     String         @default("סשן דפדפן")
  state     String // JSON: { cards, activeCard, contextCardId }
  visits    Int            @default(0) // כמה פעמים הקישורית נפתחה
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  visitsLog BrowserVisit[]

  @@index([createdAt])
}

// יומן ביקורים שנאסף בסשן — כל פעולת קריאה/חיפוש/צ'אט נרשמת
// עם חותמת-זמן. האמת נשמרת במדידה, לא בזיכרון.
model BrowserVisit {
  id        String         @id @default(cuid())
  sessionId String
  session   BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String // READ | SEARCH | CHAT
  url       String // כתובת העמוד או שאילתת החיפוש
  title     String @default("")
  createdAt DateTime       @default(now())

  @@index([sessionId])
}

// ── מרכז הדומיינים הריבוניים ─────────────────────────────────────────
// רישום הדומיינים הפרטיים שהמפעיל מתכנן להקים על הרשת. כל דומיין
// מקבל ערכת פריסה מלאה (docker-compose + Caddy + DNS) שרצה על
// שרת עצמאי — בלי GitHub, בלי ספק יישומים, בלי תלות באף אחד.
model SovereignDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  purpose   String   @default("") // מה יאוחסר/יוגש מהדומיין
  status    String   @default("PLANNED") // PLANNED | DNS | DEPLOYING | LIVE
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ── מספנת הצ'רטרים (R89 · FOUNDRY) ───────────────────────────────────
// הדלת הפתוחה של הרשת לבונים חיצוניים: סוכן ללא גישת-ריפו מקבל טוקן,
// מקים פרויקט על הרשת דרך החוזה (רישום BUILD חתום בספר hash-chained)
// ומפרסם מסמכים לקנון. הטוקן נשמר hash בלבד (SHA-256); הזהות
// אמיתית — Agent עם כתובת secp256k1; החתימה EIP-191; הראיה בקנון.

// טוקן-בונה — פתח-ברירה: מי שמחזיק בו פועל בשם ה-Agent שלו.
// נפיק ע"י המפעיל בלבד (שער /api/charter/builders או סקריפט).
model BuilderToken {
  id         String   @id @default(cuid())
  agentId    String   @unique
  agent      Agent    @relation("BuilderToken", fields: [agentId], references: [id])
  tokenHash  String   @unique // sha256(token) hex — הטוקן עצמו לעולם לא נשמר
  prefix     String // 10 התווים הראשונים — לזיהוי בכנות בלי הסוד
  issuedBy   String   @default("operator")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
}

// פרויקט-צ'רטר — ישות על הרשת שהוקמה דרך החוזה.
model CharterProject {
  id             String          @id @default(cuid())
  slug           String          @unique // קבוע ובלתי-ניתן-לשינוי מרגע ההקמה
  name           String
  purpose        String
  status         String          @default("CHARTERED") // CHARTERED | BUILDING | COMPLETE | ARCHIVED
  builderId      String
  builder        Agent           @relation("CharterBuilds", fields: [builderId], references: [id])
  attSeq         Int? // seq האימות החתום שהקים את הפרויקט בספר
  attEntryHash   String? // entryHash של אימות ההקמה — הקישור לשרשרת
  artifactsCount Int             @default(0)
  meta           String          @default("{}") // JSON חופשי של הבונה (חסום-סודות)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         CharterEvent[]

  @@index([builderId])
  @@index([status])
}

// ספר-אירועים של הפרויקט — append-only, כל שינוי נרשם עם ראיה.
model CharterEvent {
  id        String         @id @default(cuid())
  projectId String
  project   CharterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String // CHARTER | ARTIFACT | STATUS
  detail    String // JSON קנוני — מה נעשה ומה הראיה
  createdAt DateTime       @default(now())

  @@index([projectId])
}

// ── סוכן הפרסום האוטונומי (R79 · VOICE) ──────────────────────────────
// לב לולאת "הסוכנים הם המשתמשים": מפעל התוכן מייצר טיוטות מנתונים
// חיים, התור שומר אותן, ומנגנון השידור מפרסם לשרשרת החברתית. כל
// קבלה (פרמאלינק · txid) נשמרת — האמת במדידה, לא בזיכרון.
// המפתח לעולם לא נשמר כאן: הוא נגזר בזיכרון-ההרצה מה-upload של
// המפעיל בלבד, ונאמת מול הרשות החיה לפני כל שידור.
model PublishTask {
  id          String    @id @default(cuid())
  kind        String // TRUTH-REPORT | LIQUIDITY | ARSENAL | CUSTOM
  lang        String // HE | EN
  title       String
  body        String
  tags        String // רשימה מופרדת בפסיקים — SQLite בלי רשימות פרימיטיביות
  channel     String    @default("steem")
  status      String    @default("QUEUED") // QUEUED | PUBLISHING | PUBLISHED | FAILED
  permlink    String?
  txid        String?
  url         String?
  error       String?
  queuedAt    DateTime  @default(now())
  publishedAt DateTime?

  @@index([status])
  @@index([queuedAt])
}

// ── מרשם החסימות · כלכלה ריבונית (R98) ──────────────────────────────
// הוראת המפעיל: "לבחון איך לטפל ולפתוח סתימות חסימות דימומים מה שנמצא
// חסום (ולמה)." — כל חסימה בכלכלה מתועדת כאן במרשם אחד חי: מה חסום,
// למה, האם היא מכוונת (חוק/ביטחון) או חולפת (מלאי), מה פותח אותה,
// ומה הנתיב הריבוני. המדידה החיה מוספת בזמן קריאה — ה-DB הוא הקנון,
// השכבה החיה היא האמת.
model EconomyBlockage {
  id            String   @id @default(cuid())
  code          String   @unique // BLK-SBD-BUYSIDE | BLK-ETH-SOL-CAST | ...
  kind          String // CLOG (סתימה) | GATE (חסימה-שער) | BLEED (דימום) | MOORING (עגינה מכוונת)
  title         String
  what          String
  why           String
  class         String // INTENTIONAL-LEGAL | INTENTIONAL-SECURITY | INVENTORY | OPERATOR | INFRA | MEASUREMENT
  measured      String // המצב המדוד בזריעה (מוחלף בשכבה החיתה כשיש מקור)
  unlock        String // תנאי הפתיחה — מדידה, לא מילים
  sovereignPath String // הנתיב הריבוני — איך הרשת מקדמת את זה בלי לסכן את עצמה
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind])
  @@index([class])
}

// ── שער-העסקאות (R97 · TX-GATE) ──────────────────────────────────────
// הוראת המפעיל: "מערכת אוטונומית לא צריכה שער מפעיל רק במקרים של
// עסקאות באמת גדולות 100$ ומעלה." — כל פעולת-כסף מוערכת ב-USD חי
// בזמן ההחלטה: מתחת לסף — אוטונומיה מלאה; מהסף ומעלה — תור אישור
// למפעיל. כל הכרעה נשמרת עם קבלה — האמת במדידה, לא בזיכרון.
model TxGate {
  id        String    @id @default(cuid())
  source    String // money-mover | liquidity | exchange | operator
  action    String // reprice | arm-buy | swap | bridge | ...
  title     String
  payload   String // JSON קנוני — מה הייתה הפעולה
  usdValue  Float
  usdBasis  String // איך הוערך ה-USD — מקור חי, לא הנחה
  verdict   String // ALLOWED | QUEUED | REFUSED | APPROVED | REJECTED | EXECUTED
  decidedBy String // policy:<threshold | operator | policy:no-usd-mark
  reason    String
  receipt   String? // JSON — קבלת ביצוע (מונים, אימות שרשרת)
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([verdict])
  @@index([createdAt])
}
