# THE WEAVE · weave-core — .gitignore ריבוני
# חוק הברזל: סודות, מטמונים וסביבת-עבודה מקומית לעולם לא עולים לריפו.

# ── סודות (בשום פורמט) ──
upload/
*.env
.env
.env.*
!.env.example
*.pem
*.key

# ── מסד הנתונים: ה-DB הוא מטמון מקומי; האמת היא sovereign/ledger.json ──
db/*.db
db/*.db-journal
db/*.sqlite*

# ── סביבת עבודה מקומית (סנדבוקס/ניתוח — לא חלק מהמוצר) ──
sovereign-net/
agent-ctx/
tool-results/
.zscripts/
.z-ai-config/
.claude/
/local-*   # שורש בלבד! (לקח 2026-09-15: local-* גלובלי בלע את local-registry-section.tsx והקובץ אבד בקריסה)
prompt
download/

# ── SAOS-NET verify-pack — במשמרת גיט מ-2026-09-14 (Task 15-b) ──
# הקרנל "המערכת שתחליף" + ה-node state: נסרק נקי מסודות (WIF/PAT/PEM/0x-64hex —
# אפס), ההיישים ציבוריים וללא קידומת 0x. הקונסולה תלויה בו (כרטיס SAOS-NET
# מריץ replay מתמטי בכל טעינה) — רכיב שה-UI תלוי בו חייב לשרוד איפוסים.

# ── R55 · תוכן-רשת ריבוני: המשחקים והחבילות לעולם לא בריפו ──
# דרישת המפעיל: תוכן המשחקים חי על הרשת בלבד. מקורות המשחקים, החבילות
# החתומות, המניפסטים והדואר-הנכנס — כולם מחסן מקומי/שרשרת, אפס גיט.
sovereign/web/src-games/
sovereign/web/src-luck/
sovereign/web/packages/
sovereign/web/manifests/
sovereign/web/inbox/

# ── R60 · הרחבת חוק-הברזל: גם צילומי-ראיה של משחקים לעולם לא בריפו ──
# לקח R60: 17 צילומי-מסך של משחקים דלפו לאינדקס ב-R50/R55. הוסרו מה-HEAD
# ב-R60; מכאן כל צילום בעל שם-משחק נחסם עוד בטרם ייכנס לגיט.
sovereign/evidence/*game*
sovereign/evidence/*coinflip*
sovereign/evidence/*dice*
sovereign/evidence/*slots*
sovereign/evidence/*hilo*
sovereign/evidence/*snake*
sovereign/evidence/*2048*
sovereign/evidence/*wheel*
sovereign/evidence/*roulette*
sovereign/evidence/*casino*

# ── פיגומי סנדבוקס שאינם חלק מהרשת ──
skills/
examples/
mini-services/
tests/

# ── build ותלויות ──
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
bun.lockb

# ── לוגים ──
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── מערכת ──
.DS_Store
.vercel
.pnpm-debug.log*

# מסדרת הסנדבוקס (לא חלק מהרשת)
Caddyfile

saos-dex/
.tmp-work/

# ── R84: keeper daemon logs (local only, never committed) ──
sovereign/keeper/logs/
